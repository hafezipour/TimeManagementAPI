{
  "version": "1.0",
  "type": "mockflow",
  "project": {
    "name": "Simple Login Screen",
    "description": "Basic login interface mockup"
  },
  "screens": [
    {
      "id": "login-screen",
      "name": "Login Screen",
      "width": 375,
      "height": 667,
      "background": "#ffffff",
      "elements": [
        {
          "id": "header",
          "type": "text",
          "x": 50,
          "y": 100,
          "width": 275,
          "height": 40,
          "text": "Welcome Back",
          "fontSize": 24,
          "fontWeight": "bold",
          "color": "#333333",
          "textAlign": "center"
        },
        {
          "id": "email-input",
          "type": "input",
          "x": 50,
          "y": 200,
          "width": 275,
          "height": 50,
          "placeholder": "Enter your email",
          "borderRadius": 8,
          "borderColor": "#dddddd",
          "backgroundColor": "#f9f9f9"
        },
        {
          "id": "password-input",
          "type": "input",
          "x": 50,
          "y": 270,
          "width": 275,
          "height": 50,
          "placeholder": "Enter your password",
          "borderRadius": 8,
          "borderColor": "#dddddd",
          "backgroundColor": "#f9f9f9",
          "inputType": "password"
        },
        {
          "id": "login-button",
          "type": "button",
          "x": 50,
          "y": 350,
          "width": 275,
          "height": 50,
          "text": "Login",
          "backgroundColor": "#007bff",
          "textColor": "#ffffff",
          "borderRadius": 8,
          "fontSize": 16,
          "fontWeight": "bold"
        },
        {
          "id": "forgot-password",
          "type": "text",
          "x": 50,
          "y": 420,
          "width": 275,
          "height": 20,
          "text": "Forgot Password?",
          "fontSize": 14,
          "color": "#007bff",
          "textAlign": "center",
          "textDecoration": "underline"
        }
      ]
    }
  ]
}
