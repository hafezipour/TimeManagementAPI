<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3">
  <diagram name="AccrualEvaluator Control Flow" id="accrual-evaluator-diagram">
    <mxGraphModel dx="2563" dy="1290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="flow-title" value="Control Flow Sequence (Step-by-Step)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="900" y="50" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-1" value="1. Evaluate() - Entry Point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="110" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-2" value="2. Get Accrual Rules from AccrualRulesRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="170" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-3" value="3. GetAccrualProfilesByProfileOrTrackIds() - Get Employee Settings &amp; Profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="230" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-4" value="4. Create Missing Banks (AccrualBanksProcessor.CheckAndCreateBank())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="290" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-5" value="5. Get Accrual Banks for Evaluation (AccrualBanksRepository.GetAccrualBanksForEvaluation())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="350" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-6" value="6. Group Banks by Tenant, then for each tenant:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="410" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-7" value="7. GetAccrualBanksToUpdate() - Process Tenant Banks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="470" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-8" value="8. GetExistingTransactionsByBankIds() - Fetch existing transactions from AccrualTransactionsRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="530" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-9" value="9. For each Bank:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="590" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-10" value="   a. Check Tenure (if IsBaseOnYearsServed) - CalculateTenure() &amp; CheckTenureAgainstProfile()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="650" width="1380" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-11" value="   b. CalculateAccrualPeriodsAndTransactions()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="710" width="1380" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-12" value="      - CalculateAllAccrualPeriods() - Generate period dates based on frequency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="940" y="770" width="1360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-13" value="      - Find missing periods (compare with existing transactions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="940" y="830" width="1360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-14" value="      - For each missing period: CalculateAccrualAmount() &amp; check StopAccruing limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="940" y="890" width="1360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-15" value="10. InsertAccrualTransactionsBulk() - Bulk insert new transactions via AccrualTransactionsRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="950" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-step-16" value="11. UpdateAccrualBanksBulk() - Bulk update bank balances &amp; LastAccruedPeriodDate via AccrualBanksRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="900" y="1010" width="1400" height="45" as="geometry" />
        </mxCell>
